---
/**
 * PromptAnatomyDiagram.astro
 * Animated visualization of the top-to-bottom observable context layout of a Gemini Live turn:
 *   1. Session Setup (speechConfig voice + setup.tools + setup.systemInstruction) [Preserved Across SlidingWindow]
 *   2. Rolling History (prior caller & model turns, truncated at barge-in) [Sliding Window]
 *   3. Current Turn & Tool Results (latest caller utterance + FunctionResponse right before audio generation)
 */
interface Props {
  caption?: string;
}
const {
  caption = "Observable context layout of a Gemini Live turn: session setup (voice config, active tools, and systemInstruction) stays preserved across SlidingWindow compaction, while the latest caller utterance and compact FunctionResponse land right before audio generation.",
} = Astro.props;
---

<figure class="pad-wrapper">
  <svg viewBox="0 0 860 470" role="img" aria-labelledby="pad-title pad-desc" class="pad-svg">
    <title id="pad-title">Gemini Live Context Layout Across a Turn</title>
    <desc id="pad-desc">
      Top-to-bottom stack of a Gemini Live turn context: session setup containing speechConfig, active function declarations (setup.tools), and systemInstruction (base rules, current card, and session state) preserved above the SlidingWindow eviction boundary; rolling conversation history managed by SlidingWindow; and the active caller turn followed by any FunctionResponse right before audio generation.
    </desc>

    <!-- Outer Card -->
    <rect x="10" y="10" width="840" height="450" rx="14" class="card-bg" />

    <!-- Header -->
    <text x="34" y="42" class="header-title">How Gemini Live Orders Session Context (Top to Bottom)</text>
    <text x="34" y="62" class="header-sub">
      Why context position governs both recency steering and SlidingWindow retention across turns.
    </text>

    <!-- ================= LEFT COLUMN: THE 6 OBSERVABLE CONTEXT SLOTS ================= -->

    <!-- Bracket 1: Session Setup -->
    <rect x="30" y="80" width="490" height="134" rx="10" class="zone-preamble" />
    <text x="46" y="100" class="zone-tag blue-tag">1. SESSION SETUP (PRESERVED ACROSS COMPACTION)</text>

    <!-- Slot 1: Voice Config -->
    <rect x="46" y="108" width="458" height="36" rx="6" class="slot-box slot-muted" />
    <text x="58" y="130" class="slot-role muted-role">VOICE CONFIG</text>
    <text x="200" y="130" class="slot-val">speechConfig (voiceName + languageCode or replicated clip)</text>

    <!-- Slot 2: Tools & System Instruction -->
    <rect x="46" y="150" width="458" height="54" rx="6" class="slot-box slot-blue" />
    <text x="58" y="172" class="slot-role blue-role">SETUP / UPDATE</text>
    <text x="200" y="170" class="slot-val-bold">- setup.tools (active functionDeclarations)</text>
    <text x="200" y="190" class="slot-val-bold">- setup.systemInstruction (base + card + state)</text>

    <!-- SlidingWindow Eviction Boundary Line -->
    <line x1="30" y1="224" x2="520" y2="224" class="cache-line" />
    <rect x="145" y="215" width="260" height="18" rx="4" class="cache-pill" />
    <text x="275" y="227" class="cache-pill-txt" text-anchor="middle">SLIDING WINDOW EVICTION BOUNDARY</text>

    <!-- Bracket 2: Rolling Conversation History -->
    <rect x="30" y="240" width="490" height="96" rx="10" class="zone-history" />
    <text x="46" y="260" class="zone-tag amber-tag">2. ROLLING HISTORY ZONE (SLIDING WINDOW 5K / 3.5K)</text>

    <!-- Slot 3: Prior Turns -->
    <rect x="46" y="268" width="458" height="30" rx="6" class="slot-box slot-amber" />
    <text x="58" y="287" class="slot-role amber-role">PRIOR TURNS</text>
    <text x="200" y="287" class="slot-val">carried caller &amp; model audio + transcripts</text>

    <!-- Slot 4: Barge-in & Turn Metadata -->
    <rect x="46" y="302" width="458" height="26" rx="6" class="slot-box slot-muted" />
    <text x="58" y="319" class="slot-role muted-role">BARGE-IN TRIM</text>
    <text x="200" y="319" class="slot-val">interrupted model audio trimmed to heard speech</text>

    <!-- Bracket 3: Active Turn & Recency Tail -->
    <rect x="30" y="346" width="490" height="98" rx="10" class="zone-tail" />
    <text x="46" y="366" class="zone-tag green-tag">3. CURRENT TURN &amp; TOOL RESPONSE (STRONGEST STEERING)</text>

    <!-- Slot 5: Current User Turn -->
    <rect x="46" y="374" width="458" height="28" rx="6" class="slot-box slot-amber" />
    <text x="58" y="392" class="slot-role amber-role">CALLER INPUT</text>
    <text x="200" y="392" class="slot-val">latest realtimeInput audio + input transcript</text>

    <!-- Slot 6: Tool Response -->
    <rect x="46" y="406" width="458" height="30" rx="6" class="slot-box slot-green pulse-tail" />
    <text x="58" y="425" class="slot-role green-role">TOOL RESULT</text>
    <text x="200" y="425" class="slot-val-green">FunctionResponse (*_say + call_state + vocal_tone)</text>

    <!-- ================= RIGHT COLUMN: ARCHITECTURAL CONSEQUENCES ================= -->

    <!-- Callout 1: Keep Setup Lean -->
    <g class="callout-card">
      <rect x="544" y="80" width="286" height="134" rx="10" class="callout-blue" />
      <text x="560" y="104" class="callout-title blue-role">Swap Setup Per Card</text>
      <text x="560" y="124" class="callout-body">Tools and systemInstruction stay</text>
      <text x="560" y="141" class="callout-body">preserved across SlidingWindow.</text>
      <text x="560" y="161" class="callout-body">Hold base rules + current card +</text>
      <text x="560" y="178" class="callout-body">session state. Re-billed every turn:</text>
      <text x="560" y="195" class="callout-highlight-blue">keep compact &amp; swap per card only.</text>
    </g>

    <!-- Callout 2: Middle Dilution Warning -->
    <g class="callout-card">
      <rect x="544" y="240" width="286" height="96" rx="10" class="callout-amber" />
      <text x="560" y="264" class="callout-title amber-role">Why Monolithic Prompts Drift</text>
      <text x="560" y="284" class="callout-body">As 20+ turns of audio accumulate</text>
      <text x="560" y="301" class="callout-body">in the middle, fine-grained phase</text>
      <text x="560" y="318" class="callout-highlight-amber">rules buried at the top lose weight.</text>
    </g>

    <!-- Callout 3: Tool Results Steer Best -->
    <g class="callout-card">
      <rect x="544" y="346" width="286" height="98" rx="10" class="callout-green" />
      <text x="560" y="370" class="callout-title green-role">Why Tool Results Steer Best</text>
      <text x="560" y="390" class="callout-body">The newest result sits right before</text>
      <text x="560" y="407" class="callout-body">audio decoding. Keep it short:</text>
      <text x="560" y="424" class="callout-highlight-green">call_state + vocal_tone, no cards.</text>
    </g>
  </svg>
  {caption && <figcaption class="pad-caption">{caption}</figcaption>}
</figure>

<style>
  .pad-wrapper {
    margin: 1.75rem 0;
    padding: 0;
  }
  .pad-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    box-shadow: var(--gl-shadow);
    font-family: var(--sl-font, system-ui, sans-serif);
  }
  .card-bg {
    fill: var(--gl-card-bg);
    stroke: var(--gl-card-border);
    stroke-width: 1.5;
  }
  .header-title {
    font-size: 16px;
    font-weight: 700;
    fill: var(--gl-text-primary);
  }
  .header-sub {
    font-size: 12.5px;
    fill: var(--gl-text-secondary);
  }
  .zone-preamble {
    fill: var(--gl-blue-bg);
    stroke: var(--gl-blue-border);
    stroke-width: 1.25;
  }
  .zone-history {
    fill: var(--gl-amber-bg);
    stroke: var(--gl-amber-border);
    stroke-width: 1.25;
  }
  .zone-tail {
    fill: var(--gl-green-bg);
    stroke: var(--gl-green-border);
    stroke-width: 1.5;
  }
  .zone-tag {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .blue-tag, .blue-role {
    fill: var(--gl-blue-text);
  }
  .amber-tag, .amber-role {
    fill: var(--gl-amber-text);
  }
  .green-tag, .green-role {
    fill: var(--gl-green-text);
  }
  .muted-role {
    fill: var(--gl-text-muted);
  }
  .slot-box {
    fill: var(--gl-card-bg-elevated);
    stroke: var(--gl-card-border);
    stroke-width: 1;
  }
  .slot-blue {
    stroke: var(--gl-blue-border);
  }
  .slot-amber {
    stroke: var(--gl-amber-border);
  }
  .slot-green {
    stroke: var(--gl-green-border);
    stroke-width: 1.5;
  }
  .slot-role {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    font-weight: 700;
  }
  .slot-val {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    fill: var(--gl-text-secondary);
  }
  .slot-val-bold {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    fill: var(--gl-text-primary);
  }
  .slot-val-green {
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px;
    font-weight: 700;
    fill: var(--gl-green-text);
  }
  .cache-line {
    stroke: var(--gl-blue-text);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .cache-pill {
    fill: var(--gl-card-bg-elevated);
    stroke: var(--gl-blue-border);
    stroke-width: 1.2;
  }
  .cache-pill-txt {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    fill: var(--gl-blue-text);
  }
  .callout-blue {
    fill: var(--gl-card-bg-elevated);
    stroke: var(--gl-blue-border);
    stroke-width: 1.25;
  }
  .callout-amber {
    fill: var(--gl-card-bg-elevated);
    stroke: var(--gl-amber-border);
    stroke-width: 1.25;
  }
  .callout-green {
    fill: var(--gl-card-bg-elevated);
    stroke: var(--gl-green-border);
    stroke-width: 1.5;
  }
  .callout-title {
    font-size: 13px;
    font-weight: 700;
  }
  .callout-body {
    font-size: 11.5px;
    fill: var(--gl-text-secondary);
  }
  .callout-highlight-blue {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--gl-blue-text);
  }
  .callout-highlight-amber {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--gl-amber-text);
  }
  .callout-highlight-green {
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--gl-green-text);
  }
  @keyframes tailPulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.72;
    }
  }
  .pulse-tail {
    animation: tailPulse 2.6s ease-in-out infinite;
  }
  .pad-caption {
    margin-top: 0.65rem;
    font-size: 0.85rem;
    color: var(--gl-text-muted);
    text-align: center;
    line-height: 1.45;
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-tail {
      animation: none !important;
    }
  }
</style>
